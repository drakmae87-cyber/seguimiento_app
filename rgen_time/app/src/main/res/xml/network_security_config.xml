<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enables HTTP connections for local/LAN Edge AI servers (Ollama, LM Studio, llama.cpp) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
